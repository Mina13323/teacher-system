<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Never rewrite missing static assets to index.php (prevents MIME type mismatch)
    RewriteCond %{REQUEST_URI} \.(?:css|js|map|jpe?g|gif|png|webp|svg|woff2?|ttf|eot|ico)$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/assets/ [NC]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ - [R=404,L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # 1. Vite's content-hashed assets are immutable for a year.
    <FilesMatch "^[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8,}\.(css|js|woff2?|png|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # 2. Static root files (including non-hashed media/icons) can refresh daily.
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>

    # 3. CRITICAL: Keep SPA shell, manifest, and service worker scripts strictly
    # revalidatable so new deployments and worker updates are picked up immediately.
    # Placed last so it unconditionally takes precedence over any general rules above.
    <FilesMatch "^(index\.html|sw\.js|push-sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
